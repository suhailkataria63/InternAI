ENVIRONMENT=development
DATABASE_URL=sqlite:///./internai.db
FRONTEND_URL=https://intern-3tuycqr4-suhailkataria63s-projects.vercel.app
LLM_PROVIDER=mock
LLM_MODEL=mock-model
GROQ_API_KEY=
GROQ_MAX_RETRIES=1
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=600
MAX_PDF_UPLOAD_BYTES=5242880
MAX_PDF_PAGES=12
MAX_TEXT_INPUT_CHARS=20000

# For Groq application answer and cover-letter generation:
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=your_groq_api_key_here
# Set GROQ_MAX_RETRIES=0 for controlled evaluations.
GROQ_EVALUATION_MODE=false
GROQ_EVALUATION_REQUEST_BUDGET=6
GROQ_EVALUATION_TOKEN_BUDGET=12000
# Optional absolute path for evaluation reports. Defaults to backend/.local-evaluation.
# GROQ_EVALUATION_REPORT_DIR=/path/to/authorized/writable/evaluation-reports

# For local Ollama testing:
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:4b
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# For Gemini:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-flash
# GEMINI_API_KEY=your_gemini_api_key_here
